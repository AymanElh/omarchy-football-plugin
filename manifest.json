{
  "schemaVersion": 1,
  "id": "ayman.football-matches",
  "name": "Football Matches",
  "version": "2.0.0",
  "author": "Ayman",
  "license": "MIT",
  "homepage": "https://github.com/AymanElh/omarchy-football-plugin",
  "description": "Live football scores, fixtures and tables, several favourite teams, lineups on a pitch and real-time goal alerts.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Football",
    "description": "Follow your teams and competitions with live scores, lineups and real-time alerts.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "selectedLeagues": [
        "esp.1",
        "eng.1",
        "uefa.champions",
        "caf.champions",
        "caf.nations_qual",
        "mar.1"
      ],
      "favoriteTeams": [],
      "alertsEnabled": true,
      "remindersEnabled": true,
      "reminderMinutes": 15,
      "leagueAlertMode": "goals"
    }
  }
}
